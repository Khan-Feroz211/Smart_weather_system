# ===========================================================================
# Smart Weather System - environment template.  Copy to `.env` (never commit .env)
# ===========================================================================

# --- Flask --------------------------------------------------------------------
# REQUIRED. Random, >= 32 chars.  Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start outside DEBUG mode with a missing/weak key.
SECRET_KEY=
DEBUG=True
# Set true when serving over HTTPS (default: true unless DEBUG). Cookies are HttpOnly + SameSite=Lax always.
# SESSION_COOKIE_SECURE=true

# --- Existing app settings ----------------------------------------------------
OPENWEATHER_API_KEY=demo_key

# --- Weather API Provider -----------------------------------------------------
# Options: "openmeteo" (free, no API key needed) or "openweathermap" (requires key above)
# Set to "openmeteo" to use the free, open-source Open-Meteo weather API.
# See: https://open-meteo.com/  (CC BY 4.0 — attribution required)
WEATHER_PROVIDER=openmeteo
SENSOR_MODE=simulation

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# BACKEND ONLY.  Never put this in JavaScript, templates or a public repo.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Used by scripts/create_admin.py as the default administrator email.
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# Direct PostgreSQL connection (Project Settings > Database > Connection string > "Session pooler").
# BACKEND ONLY - contains the database password.  Example shape:
# postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=YOUR_SUPABASE_DB_URL

# --- Optional tuning ----------------------------------------------------------
# DB_POOL_MAX=8
# DB_STATEMENT_TIMEOUT_MS=20000
# HEARTBEAT_SECONDS=45
# ADMIN_SESSION_HOURS=8
# ADMIN_IDLE_MINUTES=60
# ALLOW_SIGNUP=true
# SEED_DEMO_DATA=true

# --- Two-Factor Authentication (TOTP) ------------------------------------------
# 2FA uses authenticator apps (Google Authenticator, Authy, etc.).
# The pyotp and qrcode packages are required – they are in requirements.txt.
# TWO_FACTOR_ISSUER is the label shown in authenticator apps (default: Smart AgriWeather).
TWO_FACTOR_ISSUER=Smart AgriWeather

# --- SMS / WhatsApp Notifications ---------------------------------------------
# Twilio credentials (required for sending real SMS / WhatsApp messages).
# If Twilio is not configured, messages are logged to the console only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional local SMS gateway URL.  When Twilio is not configured OR a WhatsApp
# message fails to send, the app falls back to this local gateway for SMS.
# Example: LOCAL_SMS_GATEWAY_URL=http://localhost:9090/sms
# If unset, local-SMS fallback degrades to a log-only message.
LOCAL_SMS_GATEWAY_URL=

# Set to "false" to disable ALL outgoing notifications.
NOTIFICATION_ENABLED=true

# --- Deep Learning Disease Detection ------------------------------------------
# Agri API auth
AGRI_REQUIRE_API_KEY=false
AGRI_API_KEY=agri_dev_key_2024

# Git LFS — store only the newly bundled large research assets as LFS objects.
# Existing committed binaries (cached models in models/, the zaraiai prompt PDF
# in the repo root, etc.) are intentionally left as regular Git blobs, so the
# patterns below are scoped to the new asset directories to avoid disturbing
# them.
data/*.csv filter=lfs diff=lfs merge=lfs -text
notebooks/*.ipynb filter=lfs diff=lfs merge=lfs -text
docs/*.pdf filter=lfs diff=lfs merge=lfs -text
models/*.pth filter=lfs diff=lfs merge=lfs -text
